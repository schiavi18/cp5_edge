#include <WiFi.h>
#include <HTTPClient.h>
#include <DHT.h>


#define DHTPIN 15
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

#define LDR_PIN 34
#define TRIG_PIN 5
#define ECHO_PIN 18

const char* ssid = "Wokwi-GUEST";
const char* password = "";


const char* fiware_server = "http://54.175.205.8:1026/v2/entities";
const char* device_id = "lamp003";
const char* service = "openiot";
const char* service_path = "/";


void setup() {
  Serial.begin(115200);
  dht.begin();

  pinMode(LDR_PIN, INPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  Serial.println("Conectando ao Wi-Fi...");
  WiFi.begin(ssid, password);

  int tentativas = 0;
  while (WiFi.status() != WL_CONNECTED && tentativas < 20) {
    delay(500);
    Serial.print(".");
    tentativas++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n Wi-Fi conectado com sucesso!");
    Serial.print("Endereço IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\n Falha ao conectar no Wi-Fi!");
  }
}

float medirDistancia() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duracao = pulseIn(ECHO_PIN, HIGH, 30000); // timeout
  return (duracao * 0.034 / 2);
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    float temperatura = dht.readTemperature();
    float umidade = dht.readHumidity();
    int luminosidade = analogRead(LDR_PIN);
    float distancia = medirDistancia();
    String alagamento = (distancia < 10.0) ? "ALERTA" : "NORMAL";

    if (isnan(temperatura) || isnan(umidade)) {
      Serial.println(" Erro ao ler o sensor DHT11");
      delay(2000);
      return;
    }

    // --- JSON para atualização ---
    /*Projeto desenvolvido exclusivamente por Julia Schiavi*/
    String json = "{";
    json += "\"temperatura\": {\"value\": " + String(temperatura, 2) + "},";
    json += "\"umidade\": {\"value\": " + String(umidade, 2) + "},";
    json += "\"luminosidade\": {\"value\": " + String(luminosidade) + "},";
    json += "\"alagamento\": {\"value\": \"" + alagamento + "\"}";
    json += "}";

    String url = String(fiware_server) + "/" + device_id + "/attrs";
    Serial.println("\n📡 Enviando para: " + url);
    Serial.println(" Corpo JSON: " + json);

    HTTPClient http;
    http.begin(url);
    http.addHeader("Content-Type", "application/json");
    http.addHeader("Fiware-Service", service);
    http.addHeader("Fiware-ServicePath", service_path);

    int httpCode = http.POST(json);

    if (httpCode > 0) {
      Serial.printf(" Código HTTP: %d\n", httpCode);
      String payload = http.getString();
      if (payload.length() > 0) {
        Serial.println(" Resposta do servidor: " + payload);
      }
    } else {
      Serial.printf(" Erro no envio! Código: %d\n", httpCode);
    }

    http.end();
  } else {
    Serial.println(" Wi-Fi desconectado!");
  }

  delay(5000); 
}
